@model List<Publicacion>
@{
    ViewData["Title"] = "Inicio";
}

@* Token antifalsificación que JavaScript manda en el header de cada POST con Fetch *@
@Html.AntiForgeryToken()

<section class="feed" id="feed">
    @if (Model.Count == 0)
    {
        <div class="feed-vacio">
            <p>Todavía no hay publicaciones.</p>
            <a class="btn btn-primario" asp-action="Crear">Creá la primera</a>
        </div>
    }

    @foreach (var p in Model)
    {
        <partial name="_Publicacion" model="p" />
    }
</section>

<div class="ver-mas">
    <button type="button" id="btnVerMas" class="btn btn-secundario btn-bloque"
            data-desde="@Model.Count" hidden="@(!(bool)ViewBag.HayMas)">
        Ver más
    </button>
    <p id="finFeed" class="fin-feed" hidden="@((bool)ViewBag.HayMas || Model.Count == 0)">No hay más publicaciones</p>
</div>
